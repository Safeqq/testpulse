{
  "name": "testpulse",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "TestPulse: aplikasi manajemen hasil test / QA (monorepo TypeScript).",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @testpulse/shared build && pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:int": "pnpm -r --if-present test:int",
    "test:contract": "pnpm --filter @testpulse/web test:contract && pnpm --filter @testpulse/reporter test:contract && pnpm --filter @testpulse/api test:contract",
    "test:mutation": "pnpm -r --workspace-concurrency=1 --no-bail --if-present test:mutation",
    "test:visual": "pnpm --filter @testpulse/tests test:visual",
    "test:visual:update": "pnpm --filter @testpulse/tests test:visual:update"
  },
  "devDependencies": {
    "allure": "^3.22.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
